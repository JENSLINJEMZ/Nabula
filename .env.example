# ---- Nebula environment (copy to .env) ----
# Server
NODE_ENV=development
PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Postgres (isolated instance on port 55432 to avoid clashing with other local DBs)
DATABASE_URL=postgres://nebula:nebula@127.0.0.1:55432/nebula

# Redis (isolated instance on port 56379)
REDIS_URL=redis://127.0.0.1:56379

# Session / CSRF
SESSION_SECRET=change-me-in-production-please-use-32+random-bytes
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Two-factor authentication (TOTP) — dedicated AES-256-GCM key for encrypting
# TOTP secrets at rest. REQUIRED in every environment and MUST differ from
# SESSION_SECRET. Generate one with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=change-me-totp-encryption-key-must-be-at-least-32-chars

# Media storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
STORAGE_QUOTA_BYTES_PER_GUILD=1073741824

# Rate limits
RATE_LIMIT_DISABLED=false

# Email (optional; email-verification / password-reset endpoints return
# MAIL_NOT_CONFIGURED in production when no relay is configured). In
# development/test, messages are captured as .eml files under MAIL_DEV_DIR
# instead of being sent.
#
# Describe the relay either as a single URL …
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# … or with discrete variables:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass
# When both are set, SMTP_URL decides host/port/protocol and SMTP_USER/SMTP_PASS
# are used only if the URL carries no credentials. An empty value counts as
# unset (SMTP_URL= turns delivery off). The test and e2e suites blank every
# SMTP_* variable, so suite mail always stays on disk.
# SMTP_FROM=Nebula <no-reply@nebula.example>
MAIL_DEV_DIR=./data/mail

# Public URL used in verification / reset email links (defaults to
# PUBLIC_WEB_ORIGIN).
# APP_URL=https://nebula.example

# Web (Vite) — must be prefixed with VITE_
VITE_API_ORIGIN=http://localhost:4000
